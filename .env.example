# Copy to .env. Every key is optional; Sift runs on local index + public APIs without any.
SIFT_DATABASE_URL=postgresql://sift:sift@postgres:5432/sift
SIFT_REDIS_URL=redis://redis:6379/0
# Identify your instance honestly to upstream APIs (Wikipedia requires a contact).
SIFT_USER_AGENT=Sift/0.1 (+https://github.com/hungnguyen1607/sift)
SIFT_STACKEXCHANGE_KEY=
SIFT_MARGINALIA_KEY=public
SIFT_PROVIDER_TIMEOUT=1.5

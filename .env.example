# Copy to .env. Every key is optional; Sift runs on local index + public APIs without any.
SIFT_DATABASE_URL=postgresql://sift:sift@postgres:5432/sift
SIFT_REDIS_URL=redis://redis:6379/0
# Identify your instance honestly to upstream APIs (Wikipedia requires a contact).
SIFT_USER_AGENT=Sift/0.1 (+https://github.com/hungnguyen1607/sift)
SIFT_STACKEXCHANGE_KEY=
SIFT_MARGINALIA_KEY=public
SIFT_GITHUB_TOKEN=
SIFT_OPENALEX_MAILTO=you@example.com
# Free web-search fallback tiers (empty key = tier disabled).
SIFT_BRAVE_KEY=
SIFT_TAVILY_KEY=
SIFT_SERPER_KEY=
# Self-hosted SearXNG web backend (no keys, no vendor). Set by docker-compose;
# override here if you run SearXNG elsewhere. When to fire it:
#   always (every cache miss, default) | auto (thin/recency/advanced) | off
SIFT_SEARXNG_URL=http://searxng:8080
SIFT_SEARCH_WEB=always
SIFT_PROVIDER_TIMEOUT=1.5
# Require an API key ("on") or allow anonymous use ("off", the default).
SIFT_AUTH=off
# Optional answer/planner/verify model (anthropic | openai, or any OpenAI-compatible
# base URL such as Ollama/vLLM). Off unless SIFT_LLM_MODEL is set.
SIFT_LLM_PROVIDER=
SIFT_LLM_BASE_URL=
SIFT_LLM_API_KEY=
SIFT_LLM_MODEL=
